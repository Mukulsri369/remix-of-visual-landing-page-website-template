{
  "entities": {
    "PrototypeRequest": {
      "title": "PrototypeRequest",
      "description": "Stores a creator's storefront prototype request submitted after Sign-Up / Sign-In.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated user UID"
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 255,
          "description": "Authenticated user email"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Creator full name"
        },
        "handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Primary social handle or URL"
        },
        "niche": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Creator niche"
        },
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Preferred storefront style"
        },
        "regions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Selected target audience countries/regions"
        },
        "storeDescription": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1500,
          "description": "Description of desired looks and features for the storefront"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of request creation"
        }
      },
      "required": [
        "uid",
        "userEmail",
        "name",
        "handle",
        "niche",
        "theme",
        "regions",
        "storeDescription",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/prototype_requests/{requestId}": {
      "schema": {
        "$ref": "#/entities/PrototypeRequest"
      },
      "description": "Collection storing storefront prototype build applications."
    }
  }
}
